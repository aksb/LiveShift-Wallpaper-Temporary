    <string name="simple_backup_import_confirm_title">Restore backup?</string>
    <string name="simple_backup_import_confirm_text">This will overwrite all current folders, rules and settings. This cannot be undone.</string>
    <string name="simple_backup_import_done_title">Restore complete</string>
    <string name="simple_backup_import_done_text">The app needs to restart to load the restored data.</string>
    <string name="simple_section_webdav">WebDAV sync</string>
    <string name="simple_webdav_tips">Same data as the local backup above (database + settings, including albums, rules, effects, reader zoom/position, current index), just sent to a WebDAV server instead. Manual "upload now"/"download now" only — no scheduled auto-sync. Conflict handling is force-overwrite, no version comparison: upload overwrites the remote file, download overwrites local data. Double-check the direction before confirming. Enter the full file path (e.g. https://dav.example.com/livewallpaper/backup.zip); the username/password are encrypted and stored on-device only, never included in the backup file itself.</string>
