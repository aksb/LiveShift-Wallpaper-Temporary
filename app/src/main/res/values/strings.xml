    <string name="simple_section_backup">Backup &amp; restore</string>
    <string name="simple_backup_tips">Local file only, does not include the images themselves — folders, wallpaper list, rules, effect settings and reader-mode zoom/position are included. After restoring, folder access needs to be re-granted and the app needs to be restarted.</string>
